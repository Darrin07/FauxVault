# --- Frontend (Vite) ---

# API base URL (usually handled by Vite proxy, but can be overridden).
VITE_API_BASE_URL=/api

# --- Docker / Postgres Initialization ---
# These values initialize the Postgres container and are also reused
# by the Express app when it connects to the database.
POSTGRES_USER=fauxvault_user
POSTGRES_PASSWORD=fauxvault_pass
POSTGRES_DB=fauxvault

# --- App Database Connection ---
# Use DB_HOST=db when the app runs inside Docker Compose.
# Use DB_HOST=localhost when running tests from the host machine
# against the Dockerized Postgres instance.
DB_HOST=db
DB_PORT=5432

# --- Auth ---
# Generate with: openssl rand -base64 48
# Rotate this in any deployment. The default placeholder below is published in
# .env.example and accepts forged JWTs anywhere it is not replaced.
JWT_SECRET=change_me_in_production

# --- CORS ---
# Comma-separated frontend origins allowed to send credentialed requests.
# Port 5174 is included as a fallback for cases where Vite cannot bind 5173.
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:5174,http://127.0.0.1,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- SQL Injection Lab (Restricted DB Role) ---
# Restricted DB role used only by the SQL injection module (sandboxed).
# This role has BYPASSRLS plus SELECT-only grants on transactions and public_accounts.
# Provisioned automatically by `npm run db:init` (chained after schema + seed).
RESTRICTED_DB_USER=fauxvault_sqli_lab
# Generate with: openssl rand -hex 16
RESTRICTED_DB_PASSWORD=
